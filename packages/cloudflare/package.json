{
	"name": "@sns-bot-framework/cloudflare",
	"version": "0.1.0",
	"description": "Cloudflare Workers adapter for sns-bot-framework: D1 stores, encrypted key storage, admin UI, worker factory",
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"bin": {
		"sns-bot-migrations": "./dist/bin/migrations.js",
		"sns-bot-setup-master-key": "./dist/bin/setup-master-key.js"
	},
	"files": [
		"dist",
		"migrations"
	],
	"sideEffects": false,
	"scripts": {
		"build": "node scripts/build-admin-client.mjs && tsc -p tsconfig.json && tsc -p tsconfig.bin.json",
		"test": "tsc -p tsconfig.client.json && vitest run",
		"publint": "publint"
	},
	"dependencies": {
		"@sns-bot-framework/core": "^0.1.0",
		"@sns-bot-framework/nostr": "^0.1.0",
		"hono": "^4.8.3"
	},
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "^0.9.12",
		"@cloudflare/workers-types": "^5.20260706.1",
		"@types/node": "^24.0.10",
		"esbuild": "^0.25.5",
		"nostr-tools": "^2.23.0",
		"vitest": "^3.2.4",
		"wrangler": "^4.22.0"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/SnowCait/nostr-bot-framework.git",
		"directory": "packages/cloudflare"
	},
	"engines": {
		"node": ">=24"
	}
}
