		"nostr-tools": "^2.23.0"
	},
	"devDependencies": {
		"vitest": "^3.2.4"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/SnowCait/nostr-bot-framework.git",
		"directory": "packages/nostr"
	},
	"engines": {
		"node": ">=24"
