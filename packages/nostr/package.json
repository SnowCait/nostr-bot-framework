{
	"name": "@sns-bot-framework/nostr",
	"version": "0.1.0",
	"description": "Nostr destination for sns-bot-framework: event building, signing, relay publishing, NIP-98",
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
