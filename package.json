{
	"name": "sns-bot-framework",
	"private": true,
	"type": "module",
	"workspaces": [
		"packages/*",
		"examples/*"
	],
	"scripts": {
		"build": "npm run build -w @sns-bot-framework/core && npm run build -w @sns-bot-framework/nostr && npm run build -w @sns-bot-framework/cloudflare",
		"typecheck": "npm run typecheck -w example-worker",
		"test": "npm run test --workspaces --if-present",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"publint": "npm run publint --workspaces --if-present"
	},
	"devDependencies": {
		"prettier": "^3.6.2",
		"publint": "^0.3.12",
		"typescript": "^5.8.3",
		"vitest": "^3.2.4"
	},
	"engines": {
		"node": ">=24",
		"npm": ">=11.10.0"
	}
}
