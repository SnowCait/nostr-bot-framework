{
	"name": "example-worker",
	"private": true,
	"type": "module",
	"scripts": {
		"types": "wrangler types",
		"typecheck": "wrangler types && tsc -p tsconfig.json",
		"dev": "wrangler dev --test-scheduled",
		"deploy": "wrangler deploy",
		"sync:migrations": "sns-bot-migrations",
		"migrate:local": "sns-bot-migrations && wrangler d1 migrations apply nostr-bot --local",
		"migrate:remote": "sns-bot-migrations && wrangler d1 migrations apply nostr-bot --remote",
		"setup:master-key:local": "sns-bot-setup-master-key --local",
		"setup:master-key:remote": "sns-bot-setup-master-key --remote"
	},
	"dependencies": {
		"@sns-bot-framework/cloudflare": "^0.1.0",
		"@sns-bot-framework/core": "^0.1.0",
		"@sns-bot-framework/nostr": "^0.1.0"
	},
	"devDependencies": {
		"wrangler": "^4.22.0"
	},
	"engines": {
		"node": ">=24"
	}
}
